#!/bin/sh

arg1=$1

CORE_DIR=`pwd`
echo "$CORE_DIR"
export CORE_DIR
# Report system settings
echo " Modules Loaded "
if [ "${HOSTNAME:0:2}" == "ys" ] ; then
  echo " "
  /glade/apps/opt/lmod/lmod/libexec/lmod sh list
elif [ "${HOSTNAME:0:2}" == "ch" ] ; then
  echo " "
  /glade/u/apps/ch/opt/Lmod/7.3.14/lmod/7.3.14/libexec/lmod sh list
elif [ `grep -c 'E5-2690 v3' /proc/cpuinfo` -gt 0 ]; then
  /apps/lmod/lmod/libexec/lmod sh list | grep echo
elif [ "${REMOTEHOST:0:11}" == "bastion-jet"  ] ; then
  /apps/lmod/lmod/libexec/lmod sh list | grep echo
fi
  echo " "

# ============================================================
# NetCDF configuration
# ============================================================

# NetCDF-C
if [ -z "${NETCDF:-}" ]; then
    if command -v nc-config >/dev/null 2>&1; then
        NETCDF=$(nc-config --prefix)
    fi
fi

if [ -z "${NETCDF:-}" ] || [ ! -d "$NETCDF/include" ]; then
    echo "ERROR: NetCDF-C installation not found."
    echo "Please load the NetCDF-C module."
    exit 1
fi

# NetCDF-Fortran
if [ -z "${NETCDF_FORTRAN:-}" ]; then
    if command -v nf-config >/dev/null 2>&1; then
        NETCDF_FORTRAN=$(nf-config --prefix)
    fi
fi

if [ -z "${NETCDF_FORTRAN:-}" ] || \
   [ ! -d "$NETCDF_FORTRAN/include" ]; then
    echo "ERROR: NetCDF-Fortran installation not found."
    echo "Please load the NetCDF-Fortran module."
    exit 1
fi

# Check NetCDF libraries
NETCDF_C_LIB=""
NETCDF_FORTRAN_LIB=""

for d in "$NETCDF/lib" "$NETCDF/lib64"; do
    if [ -f "$d/libnetcdf.so" ] || [ -f "$d/libnetcdf.a" ]; then
        NETCDF_C_LIB="$d"
        break
    fi
done

for d in "$NETCDF_FORTRAN/lib" "$NETCDF_FORTRAN/lib64"; do
    if [ -f "$d/libnetcdff.so" ] || [ -f "$d/libnetcdff.a" ]; then
        NETCDF_FORTRAN_LIB="$d"
        break
    fi
done

if [ -z "$NETCDF_C_LIB" ]; then
    echo "ERROR: NetCDF-C library not found."
    exit 1
fi

if [ -z "$NETCDF_FORTRAN_LIB" ]; then
    echo "ERROR: NetCDF-Fortran library not found."
    exit 1
fi

USENETCDFF="-lnetcdff"

export NETCDF
export NETCDF_FORTRAN
export USENETCDFF

echo "================================================"
echo " NetCDF Configuration"
echo "================================================"
echo " NetCDF-C       : $NETCDF"
echo " NetCDF-C lib   : $NETCDF_C_LIB"
echo " NetCDF-Fortran : $NETCDF_FORTRAN"
echo " Fortran lib    : $NETCDF_FORTRAN_LIB"
echo "================================================"

# Look for wrf libs
if test -z "$WRF_DIR" ; then
  for p in `pwd`/../../WRFV3
  do
    if test -d $p ; then
      WRF_DIR=$p
      break
    fi
  done
fi

if  test -z "$WRF_DIR"  ; then
 
    bedone=""
    echo '** WARNING: No path to WRF_DIR and environment variable WRF_DIR not set.'
    echo '** would you like to try to fix? [y]'
    wrfpath=""
    while [ -z "$bedone" ] ; do 
      read resp
      if [ "$resp" = "y" -o -z "$resp" ]  ; then
        if [ -z "$wrfpath" ] ; then
          echo 'Enter full path to WRF install directory on your system (i.e. $HOME/WRFV3)'
          read resp
          if [ ! -d "$resp" ] ; then
            echo "invalid path: $resp. Try again? [y]" ; continue
          fi
          wrfpath=$resp
        fi

        if [ -n "$wrfpath" ] ; then
          WRF_DIR=$wrfpath
          export WRF_DIR
          bedone="yes"
        fi
      else
        bedone="yes"
      fi
    done
fi

if [ -n "$WRF_DIR" ] ; then
  echo "Will use WRF in dir: $WRF_DIR"
else
  echo "WRF is required to compile GSI; please re-configure and try again"
  exit
fi

  # if the uname command exists, give it a shot and see if
  # we can narrow the choices; otherwise, spam 'em
  os="ARCH"
  mach="ARCH"
  type uname > /dev/null
if [ $? -eq 0 ] ; then
    os=`uname`
    if [ "$os" = "AIX" -o "$os" = "IRIX" -o "$os" = "IRIX64" -o "$os" = "SunOS" -o "$os" = "HP-UX"  -o "$os" = "Darwin" ] ; then
      mach="ARCH"
    else
      if [ "$os" = "OSF1" -o "$os" = "Linux" -o "$os" = "UNICOS/mp" -o "$os" = "UNIX_System_V" ] ; then
        mach=`uname -m`
        if [ "$mach" = "ia64" -a -f /etc/sgi-release ] ; then
            mach="Altix"
        fi
      else
        os="ARCH"
        mach="ARCH"
      fi
    fi
fi

#echo "DEBUG: NETCDF=$NETCDF"
#echo "DEBUG: NETCDF_FORTRAN=$NETCDF_FORTRAN"
#echo "DEBUG: USENETCDFF=$USENETCDFF"

# so proceed with configuration
perl arch/Config.pl \
    -corepath="$CORE_DIR" \
    -wrfpath="$WRF_DIR" \
    -netcdf="$NETCDF" \
    -netcdffpath="$NETCDF_FORTRAN" \
    -USENETCDFF="$USENETCDFF" \
    -os="$os" \
    -mach="$mach"
#perl arch/Config.pl  -corepath=$CORE_DIR -wrfpath=$WRF_DIR -netcdf=$NETCDF -USENETCDFF=$USENETCDFF -os=$os -mach=$mach 
